+// Fault injection for testing: caps one motor's PWM, like a damaged propeller.
+// fault.motor: 0 = off, 1-4 = M1-M4. fault.cap: fraction of full thrust (50% RPM leaves 25% thrust).
+static uint8_t faultMotor = 0;
+static float faultCap = 0.25f;
+
+static void applyMotorFault(motors_thrust_pwm_t* pwm) {
+  if (faultMotor < 1 || faultMotor > STABILIZER_NR_OF_MOTORS) {
+    return;
+  }
+  const float cap = fminf(fmaxf(faultCap, 0.0f), 1.0f) * UINT16_MAX;
+  if (pwm->list[faultMotor - 1] > cap) {
+    pwm->list[faultMotor - 1] = (uint16_t)cap;
+  }
+}
+
 static void controlMotors(const control_t* control) {
   powerDistribution(control, &motorThrustUncapped);
   #ifndef CONFIG_PLATFORM_SITL
