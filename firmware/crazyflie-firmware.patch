+ */
+PARAM_ADD(PARAM_UINT8, motor, &faultMotor)
+/**
+ * @brief Thrust cap of the faulty motor as a fraction of full thrust (Default: 0.25)
+ */
+PARAM_ADD(PARAM_FLOAT, cap, &faultCap)
+PARAM_GROUP_STOP(fault)
+
+/**
+ * Motor PWM actually sent to the motors, after fault injection and battery compensation
+ */
+LOG_GROUP_START(fault)
+LOG_ADD(LOG_UINT16, m1, &motorPwm.motors.m1)
+LOG_ADD(LOG_UINT16, m2, &motorPwm.motors.m2)
+LOG_ADD(LOG_UINT16, m3, &motorPwm.motors.m3)
+LOG_ADD(LOG_UINT16, m4, &motorPwm.motors.m4)
+LOG_GROUP_STOP(fault)
