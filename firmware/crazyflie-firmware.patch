+// Fault injection for testing: caps one motor's thrust, like a damaged propeller. Applied before
+// battery compensation, so the cap is a thrust (fraction of THRUST_MAX) whatever the battery level.
+// fault.motor: 0 = off, 1-4 = M1-M4. fault.cap: fraction of full thrust (50% RPM leaves 25% thrust).
+static uint8_t faultMotor = 0;
+static float faultCap = 0.25f;
+
+static void applyMotorFault(motors_thrust_uncapped_t* thrust) {
+  if (faultMotor < 1 || faultMotor > STABILIZER_NR_OF_MOTORS) {
+    return;
+  }
+  const int32_t cap = fminf(fmaxf(faultCap, 0.0f), 1.0f) * UINT16_MAX;
+  if (thrust->list[faultMotor - 1] > cap) {
+    thrust->list[faultMotor - 1] = cap;
+  }
+}
+
 static void controlMotors(const control_t* control) {
   powerDistribution(control, &motorThrustUncapped);
+  applyMotorFault(&motorThrustUncapped);
   batteryCompensation(&motorThrustUncapped, &motorThrustBatCompUncapped);
   const bool isCapped = powerDistributionCap(&motorThrustBatCompUncapped, &motorPwm);
   logCapWarning(isCapped);
@@ -405,6 +422,30 @@ PARAM_ADD_CORE(PARAM_UINT8, controller, &controllerType)
 
 PARAM_GROUP_STOP(stabilizer)
 
